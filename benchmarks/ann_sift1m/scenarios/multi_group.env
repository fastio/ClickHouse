# Multi-group scenario: 1M rows split into ~4 ANN groups of 250k each.
#
# Purpose: exercise the ANNIndexManager coordination path (group lifecycle,
# clearRetiredANNIndexGroups vs tryReserveBuildSlot races) that the
# single-group scenario bypasses entirely. Recall numbers here are expected
# to be close to single_group's but the search path issues N parallel
# DiskANN searches, so:
#   - DiskANNSearchCount per query ~ N (vs 1 in single_group)
#   - QPS at conc>1 stresses lock contention in the manager
#
# Regression探针 for the known-issue documented in README.md (the cleanup
# thread sweeping in-flight builds): if anyone re-introduces a similar
# coordination bug, sweep here will fail at build or coverage-wait time
# even when single_group is green.

ANN_GROUP_MIN_ROWS=1
ANN_GROUP_MAX_ROWS=250000
ANN_GROUP_MAX_PARTS=256
