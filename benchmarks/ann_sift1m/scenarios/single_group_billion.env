# Single ANN group covering up to 1.5B rows.
#
# Same shape as single_group / single_group_large but with a 1.5B row cap
# so 1B-class datasets (BIGANN-1B, DEEP-1B, ...) stay in one ANN group
# instead of fanning out across hundreds. Pairs with --optimize-before-build
# in the run script: streamed INSERT of 1B rows produces hundreds of parts,
# each becoming its own ANN group regardless of ann_group_max_rows because
# ANN groups are part-bound. OPTIMIZE TABLE base FINAL coalesces parts into
# one before SYSTEM BUILD ANN INDEX runs.
#
# ann_group_max_parts is bumped because 1B rows merged from streamed INSERTs
# can transit through O(1000) parts during the initial merge sequence; capping
# at 256 (the single_group_large value) would block legitimate consolidation.
#
# Pair with --keep-table on subsequent runs: a 1B build is multi-day work;
# losing it to a sweep restart is unacceptable.

ANN_GROUP_MIN_ROWS=1
ANN_GROUP_MAX_ROWS=1500000000
ANN_GROUP_MAX_PARTS=4096
