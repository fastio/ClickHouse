# Single ANN group covering the entire 1M dataset.
#
# Produces the cleanest Recall/QPS numbers because the search path is exactly
# one DiskANN search per query - no manager-level fan-out. Use this as the
# "headline" scenario when reporting absolute numbers vs the DiskANN paper.
#
# Note: this scenario does NOT exercise multi-group manager paths
# (clearRetiredANNIndexGroups, tryReserveBuildSlot, etc.) - use
# multi_group.env for that.

ANN_GROUP_MIN_ROWS=1
ANN_GROUP_MAX_ROWS=2000000
ANN_GROUP_MAX_PARTS=256
