# Single ANN group covering up to 15M rows.
#
# Same shape as single_group.env but with a much higher ann_group_max_rows
# cap so datasets larger than 2M (e.g. DEEP-image-96-angular at 9.99M) stay
# in one group instead of fanning out across 5+ groups. Use this when you
# want to isolate per-group recall from the cross-group merge loss that
# multi-group search incurs.
#
# Pairs cleanly with --keep-table on subsequent runs: the index is built
# once for a single 10M-row group and reused across the sls sweep.

ANN_GROUP_MIN_ROWS=1
ANN_GROUP_MAX_ROWS=15000000
ANN_GROUP_MAX_PARTS=256
