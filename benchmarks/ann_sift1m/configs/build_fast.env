# Lighter build profile: smaller graph, faster build, lower recall ceiling.
# Useful as a *second* point on the Pareto curve when investigating build-time
# regressions (e.g. "did this change regress the Recall vs build_seconds
# trade-off?") without doubling the wall-clock of the default sweep.
#
# `pq_chunks=8` (rather than the auto default of 4 for 128-dim) keeps the PQ
# distance approximation accurate enough that per-hop candidate selection in
# the disk graph traversal does not become the recall bottleneck — with
# `pq_chunks=4` recall collapses to near-zero regardless of `search_list_size`,
# which is not a meaningful "fast" point for any Pareto comparison.

MAX_DEGREE=32
BUILD_SEARCH_LIST_SIZE=64
ALPHA=1.2
PQ_CHUNKS=8

NUM_THREADS=64
BUILD_RAM_LIMIT_GB=8

HASH_SEED=42
