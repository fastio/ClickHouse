# DiskANN/Vamana build hyperparameters tuned for DEEP-image-96-angular
# (96-d cosine, 9.99M base, 10k query). The defaults in build_paper.env
# target SIFT-128 / 1M rows and undershoot recall at 10x scale because
# the graph stays too sparse for ~10M points.
#
# Sizing rationale (vs build_paper.env):
#   - max_degree 96 -> 96 (kept): paper-equivalent navigability for L2.
#     DEEP is angular but cosineDistance is monotone-equivalent to L2 on
#     L2-normalised vectors, so the same degree budget is sufficient.
#   - build_search_list_size 200 -> 250: 10x more points -> slightly more
#     candidates considered per insertion to maintain edge quality.
#   - alpha 1.4 -> 1.4 (kept): paper-recommended for moderate-dim graphs.
#   - pq_chunks 16 -> 16 (kept): 96-d / 6-d-per-chunk. PQ accuracy headroom
#     is similar to SIFT-128 at 8-d-per-chunk; further increase pays in
#     PQ-comparison cost during traversal without a recall benefit at 96-d.
#   - num_threads 64: parallelise build over all cores (10M points * graph
#     insertion is single-threaded otherwise).
#   - build_ram_limit_gb 8 -> 16: 10x rows + PQ codebook need headroom.
#
# Expected wall-clock on a 64-thread box: ~30-50 min, depending on disk speed.
# Pair with --build-timeout 1h and --optimize-before-build to stay under one
# ANN group.

MAX_DEGREE=96
BUILD_SEARCH_LIST_SIZE=250
ALPHA=1.4
PQ_CHUNKS=16

NUM_THREADS=64
BUILD_RAM_LIMIT_GB=16

HASH_SEED=42
