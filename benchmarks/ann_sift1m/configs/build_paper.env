# DiskANN/Vamana build hyperparameters tuned to reproduce the NeurIPS 2019
# paper's >= 0.95 Recall@10 baseline on SIFT-1M. `hash_seed` is pinned so
# repeated builds across iterations and across runs are bit-identical.
#
# These four (max_degree, build_search_list_size, alpha, pq_chunks) are the
# only inputs to the index `params_hash` - changing any of them invalidates
# the cached graph; query-side knobs (search_list_size / beam_width /
# search_io_limit) do NOT.

MAX_DEGREE=64
BUILD_SEARCH_LIST_SIZE=125
ALPHA=1.2
PQ_CHUNKS=0

NUM_THREADS=64
BUILD_RAM_LIMIT_GB=8

# Pinned so that two builds with identical (max_degree, build_search_list_size,
# alpha, pq_chunks) produce the same on-disk graph. Without this, each rebuild
# would draw a fresh RNG seed and recall variation between sls iterations would
# include graph-randomness noise.
HASH_SEED=42
